# Copiez ce fichier en « .env » (même dossier), puis collez votre clé.
# Le fichier .env reste sur votre machine : il n'est jamais envoyé sur GitHub.

# Clé d'API Phoeniqs (obligatoire)
PHOENIQS_API_KEY=

# Adresse de l'API (à changer seulement si Phoeniqs la modifie)
# PHOENIQS_BASE_URL=https://maas.phoeniqs.com/v1

# Port de la page web sur cette machine
# PORT=8765
